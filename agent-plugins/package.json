{
  "name": "@trackxai/agent-plugins",
  "version": "0.1.1",
  "private": true,
  "description": "The trackxai sign-in command and the registration helper the trackxai Pi and OpenCode plugins import.",
  "keywords": [
    "trackxai",
    "mcp",
    "login"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kalebteccom/trackxai-plugins.git",
    "directory": "agent-plugins"
  },
  "homepage": "https://github.com/kalebteccom/trackxai-plugins",
  "engines": {
    "node": ">=20.3.0"
  },
  "exports": {
    "./register-once": {
      "types": "./register-once.d.ts",
      "default": "./register-once.js"
    },
    "./login": {
      "types": "./login/index.d.ts",
      "default": "./login/index.js"
    }
  },
  "bin": {
    "trackxai": "./login/main.js"
  },
  "files": [
    "constants.d.ts",
    "constants.js",
    "login/await-token.d.ts",
    "login/await-token.js",
    "login/constants.d.ts",
    "login/constants.js",
    "login/device-api.d.ts",
    "login/device-api.js",
    "login/env-file.d.ts",
    "login/env-file.js",
    "login/harness-commands.d.ts",
    "login/harness-commands.js",
    "login/host-name.d.ts",
    "login/host-name.js",
    "login/index.d.ts",
    "login/index.js",
    "login/login-error.d.ts",
    "login/login-error.js",
    "login/logout-options.d.ts",
    "login/logout-options.js",
    "login/main.d.ts",
    "login/main.js",
    "login/options.d.ts",
    "login/options.js",
    "login/profile.d.ts",
    "login/profile.js",
    "login/revoke-api.d.ts",
    "login/revoke-api.js",
    "login/run-login.d.ts",
    "login/run-login.js",
    "login/run-logout.d.ts",
    "login/run-logout.js",
    "login/server-url.d.ts",
    "login/server-url.js",
    "package-root.d.ts",
    "package-root.js",
    "register-once.d.ts",
    "register-once.js",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "zod": "3.25.76"
  }
}
